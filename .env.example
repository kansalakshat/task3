# Copy to .env and fill in. .env is gitignored -- keep it that way.

# ---- Stage 2: reverse image search ----
# https://serpapi.com/manage-api-key  (free tier: 100 searches/month)
# Leave blank to run stages 1 + 3 only; stage 2 records "no match" and moves on.
SERPAPI_KEY=

# ---- Stage 3: blockchain ----
# Sepolia RPC endpoint (Alchemy / Infura / any public Sepolia node).
# Leave BOTH of the next two blank to fall back to a local Hardhat node at
# http://127.0.0.1:8545 -- no test ETH and no RPC account required.
SEPOLIA_RPC_URL=

# !!! TESTNET THROWAWAY KEY ONLY !!!
# NEVER put a real, funded, or mainnet private key here. Generate a fresh
# wallet, fund it from a Sepolia faucet, and treat it as disposable. Anything
# in this file is one bad `git add -f` away from being public forever.
PRIVATE_KEY=

# The deployed contract address is written to deployment.json by
# `npx hardhat run scripts/deploy.js` -- you do not set it here.
